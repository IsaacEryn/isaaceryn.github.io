{
  "name": "act-rules-tool-comparison",
  "private": true,
  "type": "module",
  "description": "W3C ACT 승인 규칙 테스트 케이스에 axe-core와 IBM Equal Access를 기본 설정으로 돌려 기대 결과와 비교",
  "scripts": {
    "fetch": "curl -fsSL https://www.w3.org/WAI/content-assets/wcag-act-rules/testcases.json -o testcases.json",
    "run": "node run.mjs",
    "analyze": "python3 analyze.py"
  },
  "dependencies": {
    "accessibility-checker-engine": "4.0.34",
    "axe-core": "4.14.0",
    "playwright": "1.63.0"
  }
}
